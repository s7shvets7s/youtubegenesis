# Copy this file to .env and paste your Pexels API key below.
# Never commit a real API key.
PEXELS_API_KEY=your_pexels_api_key_here

# Optional second stock provider
PIXABAY_API_KEY=
# Reserved; NARA live access is disabled pending storage-policy resolution
NARA_API_KEY=

# Optional official Jamendo API client id for AI music fallback
JAMENDO_CLIENT_ID=
